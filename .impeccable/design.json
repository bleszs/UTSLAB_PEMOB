  "narrative": {
    "northStar": "Rasa ingin tahu, bertemu tantangan.",
    "overview": "Quizora memakai ungu cerah, kuning hangat, Nunito membulat, dan ilustrasi edukasi serta piala 3D sesuai brief pengguna. Permukaan tenang memberi ruang untuk pertanyaan, nama pengguna, dan satu tindakan berikutnya. Tampilan tetap ramah ketika pengguna mempelajari jawaban yang salah.\n\nSistem berasal dari implementasi Flutter Material 3, bukan dari perkiraan mockup. Token di atas mencatat nilai eksplisit dalam `lib/utils/app_theme.dart` dan komponen; satuan px mewakili logical pixel Flutter sebelum skala teks perangkat. Varian komponen frontmatter menunjukkan mode terang. Mode gelap memakai pemetaan warna semantik di bawah, sedangkan panel skor mempertahankan identitas ungu/kuning. Sidecar berisi terjemahan HTML untuk pratinjau komponen, bukan pengganti rendering Flutter.",
    "keyCharacteristics": [
      "Ungu untuk identitas, pilihan aktif, dan progress; kuning untuk tindakan utama dan skor.",
      "Nunito lokal dengan judul tebal dan teks isi berjarak lega.",
      "Permukaan membulat, outline lembut, dan bayangan Material terbatas pada tombol utama.",
      "Tata letak satu kolom yang berubah menjadi dua kolom saat ruang konten mencukupi.",
      "Mode terang dan gelap dengan label serta indikator status yang tetap terbaca."
    ],
    "rules": [
      {
        "name": "The Purple Selection Rule",
        "body": "Pilihan aktif memakai primary dan onPrimary dari tema; ikon centang dan state semantik ikut menyatakan pilihan.",
        "section": "colors"
      },
      {
        "name": "The Yellow Action Rule",
        "body": "Tindakan utama memakai kuning dengan tinta gelap; panel hasil memakai kuning untuk angka skor dan ungu tetap untuk latarnya.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Semua teks antarmuka memakai Nunito; hierarki berasal dari ukuran, bobot, dan warna semantik.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** gunakan primary dan onPrimary tema untuk opsi terpilih, termasuk mode gelap.",
      "**Do** gunakan Nunito lokal dan peran tipografi frontmatter pada layar tambahan.",
      "**Do** pertahankan teks, ikon status, dan Semantics bersama warna pilihan serta skor.",
      "**Do** beri ruang untuk wrapping, skala teks, dan scroll di dalam SafeArea.",
      "**Do** pertahankan ilustrasi edukasi dan piala tanpa crop yang merusak bentuknya."
    ],
    "donts": [
      "**Don't** gunakan teks putih pada tombol kuning; gunakan tinta gelap.",
      "**Don't** hardcode ungu terang untuk kontrol tema gelap yang sudah memiliki primary semantik.",
      "**Don't** tambahkan shadow kartu atau animasi khusus sebagai aturan sistem tanpa implementasi yang mendasarinya.",
      "**Don't** menyebut screenshot renderer pengujian sebagai bukti emulator atau perangkat fisik."
    ]
  }
}
